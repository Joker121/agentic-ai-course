# LLM Configuration
LLM_API_KEY=your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Anthropic (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Railway
RAILWAY_PROJECT_ID=your-railway-project-id
RAILWAY_TOKEN=your-railway-token

# Database (Railway provides these automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_ai
PGVECTOR_URL=postgresql://user:password@localhost:5432/agentic_ai

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# A2A Configuration
A2A_BASE_URL=http://localhost:8000
A2A_REGISTRY_URL=http://localhost:8000/a2a/registry
