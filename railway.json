{
  "$schema": "https://cdn.railway.app/railway.schema.json",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "port": 8000
  },
  "services": {
    "postgres": {
      "plugin": "postgresql",
      "plan": "development"
    },
    "redis": {
      "plugin": "redis",
      "plan": "development"
    }
  },
  "environments": {
    "staging": {
      "build": {
        "dockerfile": "Dockerfile"
      },
      "deploy": {
        "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT",
        "healthcheckPath": "/health"
      }
    },
    "production": {
      "build": {
        "dockerfile": "Dockerfile"
      },
      "deploy": {
        "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT",
        "healthcheckPath": "/health",
        "replicas": 2
      }
    }
  }
}
